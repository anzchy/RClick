#!/usr/bin/env python3
"""Finite poll fixture; all per-test values are data in the environment."""
import json
import os
import sys
from pathlib import Path

calls = os.environ.get('POLL_CALLS')
if calls:
    with open(calls, 'a') as out:
        out.write(' '.join(sys.argv[1:]) + '\n')
if sys.argv[2:4] == ['read', 'w1:p3']:
    print('Worked for 1m')
    sys.exit(0)
if sys.argv[2:4] != ['get', 'w1:p3']:
    sys.stderr.write('agent_not_found')
    sys.exit(1)
count = os.environ.get('POLL_COUNT')
if count:
    count = Path(count)
    n = int(count.read_text()) + 1 if count.exists() else 1
    count.write_text(str(n))
    if n <= int(os.environ.get('POLL_FAILURES', '0')):
        sys.stderr.write('temporary lookup failure')
        sys.exit(1)
terminal = 'term_replaced' if os.environ.get('POLL_MISMATCH') == '1' else 'term_abc123'
print(json.dumps({'result': {'type': 'agent_info', 'agent': {
    'name': '', 'pane_id': 'w1:p3', 'terminal_id': terminal, 'agent_status': 'done'}}}))
