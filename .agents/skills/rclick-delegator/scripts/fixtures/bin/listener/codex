#!/usr/bin/env python3
"""Scratch queue transport; records the same receipts and argv as the original fakes."""
import json
import os
import sys
import time
from pathlib import Path

mode = os.environ['LISTENER_CODEX_MODE']
if mode == 'capture-message':
    Path(os.environ['CAPTURED_MESSAGE']).write_text(sys.argv[-1])
elif mode == 'capture-argv':
    Path(os.environ['CAPTURED_ARGV']).write_text(json.dumps(sys.argv[1:]))
elif mode in ('stop', 'late'):
    root = Path(os.environ['STOP_TEST_ROOT'])
    if mode == 'late':
        with (root / 'codex-accepted').open('a') as out:
            out.write('x')
        time.sleep(3)
        print('late receipt')
        sys.exit(0)
    (root / 'codex-started').write_text(str(os.getpid()))
    while os.environ['LISTENER_BLOCK'] == 'True' and not (root / 'release').exists():
        time.sleep(0.02)
    (root / 'codex-argv.json').write_text(json.dumps(sys.argv[1:]))
elif mode != 'queued':
    raise ValueError(mode)
print('scratch queued' if mode in ('queued', 'capture-message') else 'scratch queue receipt')
