{
  "sourceLanguage": "en",
  "strings": {
    "Unable to Save File Type" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to Save File Type"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存文件类型"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル形式を保存できません"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede guardar el tipo de archivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer le type de fichier"
          }
        }
      }
    },
    "Enter a file extension without slashes, such as txt or .txt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a file extension without slashes, such as txt or .txt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入不含斜杠的文件扩展名，例如 txt 或 .txt。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "txt や .txt のように、スラッシュを含まない拡張子を入力してください。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una extensión sin barras, como txt o .txt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une extension sans barre oblique, telle que txt ou .txt."
          }
        }
      }
    },
    "A move is already in progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A move is already in progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动正在进行中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動処理が進行中です"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un movimiento en curso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un déplacement est déjà en cours"
          }
        }
      }
    },
    "Undo last move" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo last move"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销上次移动"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の移動を取り消す"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer el último movimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler le dernier déplacement"
          }
        }
      }
    },
    "There is no move to undo" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no move to undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可撤销的移动"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せる移動はありません"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún movimiento que deshacer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun déplacement à annuler"
          }
        }
      }
    },
    "Undo requires access to both folders" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo requires access to both folders"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销需要获得两个文件夹的访问权限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消すには両方のフォルダへのアクセスが必要です"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para deshacer se necesita acceso a ambas carpetas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation nécessite l’accès aux deux dossiers"
          }
        }
      }
    },
    "Some items could not be restored:\n%@" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items could not be restored:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分项目无法恢复：\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の項目を元に戻せませんでした：\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar algunos elementos:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments n’ont pas pu être restaurés :\n%@"
          }
        }
      }
    },
    "The moved item is missing or has changed" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moved item is missing or has changed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移动的项目丢失或已更改"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動した項目が見つからないか、変更されています"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento movido falta o ha cambiado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément déplacé est introuvable ou a changé"
          }
        }
      }
    },
    "The original folder is missing or unavailable" : {
      "localizations": {
        "en": {
